OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-6-luna

# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_PHONE_NUMBER=+15551234567

# Local app settings
APP_TIMEZONE=America/Los_Angeles
SESSION_DB_PATH=data/conversations.db
COORDINATION_DB_PATH=data/coordination.db
TWILIO_BOT_AUTHOR=Arky
# Set true when routing all inbound SMS/MMS through Twilio Conversations autocreation.
TWILIO_CONVERSATIONS_MODE=false

# Google Calendar OAuth
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=data/google-token.json
GOOGLE_CALENDAR_ID=primary

# Keep false for the first local test. Set true once the webhook is public.
TWILIO_VALIDATE_REQUESTS=false
